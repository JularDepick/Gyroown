<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gyroown.Controls.VaultSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Gyroown.Controls"
    mc:Ignorable="d"
    MinWidth="180">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Quick Access -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,8,12,4">
                <FontIcon Grid.Column="0" Glyph="&#xE730;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" x:Name="QuickAccessLabel" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1" x:Name="QuickAccessContainer" Spacing="1" Margin="8,0,8,4" />
        </Grid>

        <!-- Divider -->
        <Border Grid.Row="1" Height="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                Margin="12,4" />

        <!-- Favorites panel -->
        <controls:FavoritesPanel
            Grid.Row="2"
            x:Name="Favorites" />

        <!-- Divider -->
        <Border
            Grid.Row="3"
            Height="1"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            Margin="12,4" />

        <!-- Folder tree -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*">
            <TextBlock
                Grid.Row="0"
                x:Name="FoldersLabel"
                FontWeight="SemiBold"
                Margin="12,8" />

            <TreeView
                Grid.Row="1"
                x:Name="FolderTreeView"
                SelectionChanged="OnFolderSelected"
                AllowDrop="True"
                DragOver="OnFolderDragOver" Drop="OnFolderDrop"
                Padding="8,4" />
        </Grid>
    </Grid>
</UserControl>
