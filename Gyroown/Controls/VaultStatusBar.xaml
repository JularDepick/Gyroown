<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gyroown.Controls.VaultStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="28">

    <Grid
        ColumnDefinitions="Auto,*,Auto"
        Padding="12,0"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock
                x:Name="ItemCountText"
                Text=""
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="SelectionInfoText"
                Text=""
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </StackPanel>

        <TextBlock
            Grid.Column="1"
            x:Name="VaultPathText"
            Text=""
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Center">
            <Button x:Name="ViewDetailsBtn" Width="24" Height="20" Padding="2"
                    Click="OnViewDetailsClick" ToolTipService.ToolTip="Details">
                <FontIcon Glyph="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
            </Button>
            <Button x:Name="ViewIconsBtn" Width="24" Height="20" Padding="2"
                    Click="OnViewIconsClick" ToolTipService.ToolTip="Icons">
                <FontIcon Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
            </Button>
            <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />
            <FontIcon x:Name="LockIcon"
                Glyph="&#xE72E;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            <TextBlock
                x:Name="LockStatusText"
                Text=""
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
